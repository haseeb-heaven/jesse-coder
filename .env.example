# ==============================================================================
# JesseCoder Environment Configuration Template
# Copy this file to .env and configure your personal API credentials.
# NEVER commit your real .env file containing live secrets to git.
# ==============================================================================

# Jesse API Authentication
JESSE_API_KEY=your_api_key_here

# Jesse OpenAI-Compatible Endpoint
JESSE_BASE_URL=https://jesse.solidsf.com/api/v1

# Target Model (jesse-prod, jesse-pristine, jesse)
JESSE_MODEL=jesse-prod

# Agent Sampling Parameters
JESSE_TEMPERATURE=0.2
JESSE_TIMEOUT=60.0

# Execution Backend: "local" spawns local subprocesses; "online" routes compiled
# languages (cpp / javascript / c) to the hosted Code Runner service, which carries
# its own JDoodle credentials. Python always runs locally.
# JESSE_EXECUTION_BACKEND=local
# JESSE_ONLINE_COMPILER_URL=https://code-runner-plugin.vercel.app
